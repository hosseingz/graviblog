# Django 12-Factor Configuration
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=change-this-insecure-key-in-production-use-a-strong-secret-key-here

# Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Database (PostgreSQL fallback to SQLite if DB not configured)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://django_user:django_password@db:5432/django_db

# Cache & Redis
REDIS_URL=redis://127.0.0.1:6379/1

