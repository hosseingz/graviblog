# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and supply project-specific values.
# NEVER commit the active .env file containing production secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Set DEBUG=0 in production environments
DEBUG=0
# Generate a cryptographically secure key: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-this-insecure-default-key-to-a-cryptographically-secure-random-string
# Comma-separated list of fully qualified hostnames allowed to serve the application
ALLOWED_HOSTS=localhost,127.0.0.1,backend,api.example.com
# Path to the active settings module
DJANGO_SETTINGS_MODULE=config.settings

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis & Celery Asynchronous Queue
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379/1
CELERY_BROKER_URL=redis://:replace_with_strong_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace_with_strong_redis_password@redis:6379/0

# ------------------------------------------------------------------------------
# Security, CORS & CSRF Whitelisting
# ------------------------------------------------------------------------------
# Comma-separated trusted origins for browser client access
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.example.com

# ------------------------------------------------------------------------------
# Dual-Environment Networking for Next.js App Router
# ------------------------------------------------------------------------------
# Internal Docker bridge address used exclusively by Server-Side Rendering (Node SSR)
INTERNAL_API_BASE_URL=http://backend:8000
# External URL reachable by client browsers via public edge gateway/reverse proxy
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
