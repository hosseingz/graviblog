# ==============================================================================
# Multi-Stage Dockerfile for Production Django Backend
# Base Image: Python 3.12 Debian Slim (glibc support for binary wheels)
# ==============================================================================

# Stage 1: Build Dependencies and Python Wheels
FROM python:3.12-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Install build-time dependencies required for C-extensions
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl && \
    rm -rf /var/lib/apt/lists/*

# Install python dependencies to wheel cache
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip wheel --wheel-dir /build/wheels -r requirements.txt


# Stage 2: Minimal Production Runtime
FROM python:3.12-slim-bookworm AS runner

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/venv/bin:$PATH"

WORKDIR /src

# Install essential runtime shared libraries (libpq for postgresql client)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq5 \
        curl && \
    rm -rf /var/lib/apt/lists/*

# Create unprivileged system group and user (UID/GID 1001)
RUN groupadd --system --gid 1001 appgroup && \
    useradd --system --uid 1001 --gid appgroup --no-create-home --shell /bin/false appuser

# Create isolated Python virtual environment
RUN python -m venv /venv

# Copy pre-compiled wheels from builder stage and install into virtual environment
COPY --from=builder /build/wheels /wheels
RUN /venv/bin/pip install --no-cache-dir --upgrade pip && \
    /venv/bin/pip install --no-cache-dir /wheels/* && \
    rm -rf /wheels

# Pre-create required directory structure and configure permissions
RUN mkdir -p /src/static /src/media /src/logs && \
    chown -R appuser:appgroup /src /venv

# Copy entrypoint script and ensure execution permissions
COPY --chown=appuser:appgroup entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && sed -i 's/\r$//' /entrypoint.sh

# Copy application source code with unprivileged ownership
COPY --chown=appuser:appgroup . /src

# Switch to unprivileged execution user
USER appuser

# Healthcheck probe using internal status check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120"]
