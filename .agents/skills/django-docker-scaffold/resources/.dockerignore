# ==============================================================================
# Docker Build Exclusion List (.dockerignore)
# Minimizes build context size, prevents cache bust, and protects secrets
# ==============================================================================

# Git & Repository metadata
.git
.gitignore
.gitattributes
.github

# Secrets and Local Environment Files
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt

# Python Bytecode & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing, Coverage & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# IDE & OS Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Django Local Storage & Runtime Artifacts
*.sqlite3
*.sqlite3-journal
logs/
*.log
static/
media/

# Node & Frontend Build Artifacts (if context is root)
node_modules/
.next/
dist/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
