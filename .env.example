# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and supply project-specific values.
# NEVER commit the active .env file containing production secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DEBUG=0
SECRET_KEY=change-this-insecure-default-key-to-a-cryptographically-secure-random-string
JWT_SIGNING_KEY=change-this-insecure-default-jwt-key-never-reuse-secret-key
ENVIRONMENT=production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,django-app,testserver,api.example.com
DJANGO_SETTINGS_MODULE=config.settings

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis & Celery Asynchronous Queue
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379/1
CELERY_BROKER_URL=redis://:replace_with_strong_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace_with_strong_redis_password@redis:6379/0

# ------------------------------------------------------------------------------
# Security, CORS & CSRF Whitelisting
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# Dual-Environment Networking for Next.js App Router
# ------------------------------------------------------------------------------
INTERNAL_API_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Frontend Docker Build: npm Registry
# Optional. Override when registry.npmjs.org is unreachable/slow from the Docker
# build (the image install fails loudly instead of producing a broken layer).
# ------------------------------------------------------------------------------
# NPM_REGISTRY=https://registry.npmmirror.com
